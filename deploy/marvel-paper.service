[Unit]
Description=Marvel prospective paper worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/marvel-trading-demo
ExecStart=%h/marvel-trading-demo/.venv/bin/python -m marvel_ops worker --allow-network
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
